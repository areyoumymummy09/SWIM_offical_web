{
  "name": "swim",
  "version": "1.0.0",
  "description": "S.W.I.M. Official Theme",
  "author": "S.W.I.M.",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@wordpress/browserslist-config": "^4.0.1",
    "@wordpress/eslint-plugin": "^9.0.6",
    "@wordpress/scripts": "19.2.2",
    "@wordpress/stylelint-config": "^19.0.5",
    "autoprefixer": "^10.2.6",
    "chokidar-cli": "^2.1.0",
    "eslint": "^7.28.0",
    "minimist": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.3.0",
    "postcss-calc": "^8.0.0",
    "postcss-cli": "^8.3.1",
    "postcss-css-variables": "^0.18.0",
    "postcss-custom-media": "^8.0.0",
    "postcss-discard-duplicates": "^5.0.1",
    "postcss-focus-within": "^4.0.0",
    "postcss-nested": "^5.0.5",
    "rtlcss": "^3.2.0",
    "sass": "^1.34.1",
    "stylelint": "^13.13.1",
    "stylelint-config-recommended-scss": "^4.2.0"
  },
  "scripts": {
    "build:style": "sass assets/sass/style.scss:style.css --style=expanded --source-map",
    "build:js": "wp-scripts build",
    "build": "run-s \"build:*\"",
    "watch": "chokidar \"**/*.scss\" -c \"npm run build:style\" --initial",
    "lint:scss": "stylelint **/*.scss",
    "lint-fix:scss": "stylelint **/*.scss --fix"
  },
  "dependencies": {
    "bootstrap": "^5.1.3",
    "foundation-sites": "^6.7.4",
    "jquery": "^3.6.0"
  }
}
